# =============== Python ===============
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
venv/
env/
.venv/

# =============== PyInstaller 打包产物 ===============
build/
dist/
/dist_v*/
/build_v*/
*.spec

# =============== IDE ===============
.idea/
.vscode/
*.swp
*.swo

# =============== 上下文锁文件 ===============
.ctx.lock

# =============== 数据库 & 数据文件（绝对不能进仓库） ===============
app/storage/*.db
app/storage/*.db-journal
app/storage/*.db-wal
app/storage/*.db-shm
app/storage/license.dat
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# =============== 临时文件 ===============
_tmp.js
_tmp.py
AvatarAIAdmin/
*.lic
*.lic.bak
*.mc

# 配置文件（含密钥，不进仓库）
data/config.json

# =============== 敏感凭证（方案 A：git 永远不跟踪） ===============
app/storage/_secrets.py
*_secrets.py
.env
secrets.json
*.pem

# =============== 临时脚本 / 过程产物（开发调试用，不进仓库） ===============
# 注意：只忽略仓库【根目录】下的下划线开头项；不要写成 `_*.py`，
# 否则会连 app/ 下所有包文件 `__init__.py`（以及 app/apps/_scheduler_common.py）一起忽略掉。
/_*
**/tests/_smoke_*.py

# =============== 渠道 CLI 二进制（打包必需，但不进 git，只保留本地） ===============
# dws.exe / lark-cli.exe / wecom-cli.exe 合计约 90MB，spec 会打进 EXE 的
# channels/ 目录；仓库里不跟踪，换机器时需从官方安装包重新解出。
/channels/

# =============== 抢救/审计过程产物、解包产物（不发布） ===============
/*.exe_extracted/
/pycd*.exe
/AIBridgeConsole_MVP_Test_20260729/
/recovered_repo/
/recovered_source/

# =============== 日志 ===============
*.log
logs/

# =============== 测试临时数据 ===============
tests/data/tmp_*/

# =============== 系统 ===============
.DS_Store
Thumbs.db
desktop.ini

# =============== QtWebEngine 缓存 ===============
WebEngineCache/
QtWebEngineProcess*

# =============== 其他 ===============
*.bak
*.tmp
